# ---------------------------------------------------------------------------
# Lead capture ("Book a demo" form). Each sink is optional and independent —
# set the vars for a sink and it activates. With none set, the form still works
# and logs leads to the server console (local dev).
# ---------------------------------------------------------------------------

# Supabase — persist every lead to the `leads` table (bypasses RLS server-side).
# Use the SERVICE ROLE key (server-only secret) — never the anon/public key here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — instant email alert to the Solarsearch sales inbox.
RESEND_API_KEY=
LEAD_ALERT_TO=            # e.g. sales@solarsearch.example (comma-separate for multiple)
LEAD_ALERT_FROM=Solarsafe Leads <onboarding@resend.dev>  # verify your own domain in Resend for production

# Kudosity (formerly Burst SMS / TransmitSMS) — instant SMS alert. Drop-in:
# fill these three and SMS alerts start firing.
KUDOSITY_API_KEY=
KUDOSITY_API_SECRET=
KUDOSITY_ALERT_TO=       # destination mobile, e.g. 61400000000
# KUDOSITY_SENDER=       # optional dedicated sender / virtual number
# KUDOSITY_API_BASE=https://api.transmitsms.com  # override only if your account uses a different base
